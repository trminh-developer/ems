PORT=3000
USE_MOCK_DB=true
PAYMENT_MODE=sandbox
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Additional frontend origins, separated by commas (include custom production domains).
CORS_ORIGINS=

# Discover: bounded retrieval across interests, activity and new profiles.
DISCOVERY_CANDIDATE_BATCH_SIZE=500
DISCOVERY_MAX_CANDIDATES=1500

# VNPAY SANDBOX
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Configure VNPay IPN in the merchant portal: <public BACKEND_URL>/api/payments/vnpay/ipn

# MOMO SANDBOX
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# Return URL is generated from BACKEND_URL: /api/payments/momo/return
MOMO_IPN_URL=https://YOUR_NGROK_ID.ngrok.app/api/payments/momo/ipn

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe webhook: <public BACKEND_URL>/api/payments/stripe/webhook
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
